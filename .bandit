# Bandit security checker configuration

# Tests to exclude
exclude_dirs:
  - tests
  - venv
  - .venv

# Skips certain tests
skips:
  - B101  # Assert used - fine for tests
  - B601  # Paramiko call with policy - SSH usage

# Test severity threshold (LOW, MEDIUM, HIGH)
severity_level: MEDIUM

# Assertion level (LOW, MEDIUM, HIGH)
confidence_level: HIGH

# Tests to run (if not skipped)
# See https://bandit.readthedocs.io/en/latest/plugins/index.html
